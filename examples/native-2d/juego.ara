externa "user32.dll" func CreateWindowExW(estilo_ext: u32, nombre_clase: entero, titulo: entero, estilo: u32, x: i32, y_: i32, ancho: i32, alto: i32, padre: entero, menu: entero, instancia: entero, datos: entero) -> entero
externa "user32.dll" func DefWindowProcW(ventana: entero, mensaje: u32, w: entero, l: entero) -> entero
