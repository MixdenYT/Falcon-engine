const WM_DESTROY = 2
const WM_PAINT = 15
const WM_CLOSE = 16
const CS_VREDRAW_HREDRAW_OWNDC = 35
const WS_OVERLAPPEDWINDOW = 13565952
const WS_VISIBLE = 268435456
const IDC_ARROW = 32512
const PM_REMOVE = 1
const GL_COLOR_BUFFER_BIT = 16384
const GL_PROJECTION = 5889
const GL_BGRA = 32993
const GL_UNSIGNED_BYTE = 5121
const VK_SPACE = 32
const VK_LEFT = 37
const VK_UP = 38
const VK_RIGHT = 39
const TECLA_A = 65
const TECLA_D = 68
const TECLA_W = 87
const ANCHO = 1280
const ALTO = 720
const PASOS_CAPTURA = 150  # sin FALCON_CAPTURA_PASOS

global cerrada = falso

func ventana_proc(ventana: entero, mensaje: entero, w: entero, l: entero) -> entero:
    msg = mensaje % 4294967296  # un UINT llega con la mitad alta sin definir
    si msg == WM_PAINT:
        ValidateRect(ventana, 0)
        devolver 0
    si msg == WM_CLOSE:
        DestroyWindow(ventana)
        devolver 0
    si msg == WM_DESTROY:
        cerrada = verdadero
        PostQuitMessage(0)
        devolver 0
    devolver DefWindowProcW(ventana, msg, w, l)

# ---------- La entrada ----------

# El guion en el paso `i` (como `accionesDelGuion` de herramientas/escena-nativa-2d.mjs): sin guion, andar a la
# derecha (a la izquierda un rato de cada cuatro) y saltar cada 35 pasos.
func guion_en(guion: texto, i: entero) -> entero:
    si guion == "":
        b = 1
        si (i // 120) % 4 == 3:
            b = 2
        si i % 35 == 10:
            b += 4
        devolver b
    letras = bytes(guion)
    devolver letras[minimo(i, largo(letras) - 1)] - 97

# Pone en el anfitrión las acciones de este paso (`b`: 1 derecha, 2 izquierda, 4 saltar) y lo que se acaba de pulsar
# o soltar respecto a las de antes, en el orden de las acciones del proyecto.
func entrada(b: entero):
    ahora: lista[texto] = []
    para k en rango(3):
        si b // [2, 1, 4][k] % 2 == 1:
            agregar(ahora, ["izquierda", "derecha", "saltar"][k])
    antes = mundo.mantenidas
    mundo.pulsadas = []
    mundo.soltadas = []
    para a en ["izquierda", "derecha", "saltar"]:
        si contiene(ahora, a) y no contiene(antes, a):
            agregar(mundo.pulsadas, a)
        si contiene(antes, a) y no contiene(ahora, a):
            agregar(mundo.soltadas, a)
    mundo.mantenidas = ahora

# Un decimal con 17 cifras: basta para leerlo de vuelta exacto (la prueba compara bit a bit).
func cifras(b: Bufer, x: decimal) -> texto:
    _gcvt(x, 17, direccion(b, 0))
    n = 0
    mientras leer_u8(b, n) != 0:
        n += 1
    letras: lista[entero] = []
    para k en rango(n):
        agregar(letras, leer_u8(b, k))
    devolver texto_de_bytes(letras, 0, n)

# Una variable de entorno (vacío si no está).
func variable(b: Bufer, nombre: texto) -> texto:
    poner_texto_ancho(b, 0, nombre)
    n = GetEnvironmentVariableW(direccion(b, 0), 0, 0)  # lo que ocupa, con el 0 del final (0 si no está)
    si n == 0:
        devolver ""
    v = bufer(2 * n)
    n = GetEnvironmentVariableW(direccion(b, 0), direccion(v, 0), n)
    letras: lista[entero] = []
    para k en rango(n):
        agregar(letras, leer_u16(v, 2 * k))
    soltar_bufer(v)
    devolver texto_de_bytes(letras, 0, largo(letras))

func segundos(b: Bufer, frecuencia: entero) -> decimal:
    QueryPerformanceCounter(direccion(b, 0))
    devolver decimal(leer_i64(b, 0)) / decimal(frecuencia)

func pulsada(tecla: entero) -> booleano:
    devolver GetAsyncKeyState(tecla) % 65536 >= 32768

func color(c: entero):
    glColor3d(decimal(c // 65536) / 255.0, decimal(c // 256 % 256) / 255.0, decimal(c % 256) / 255.0)

# Rectángulos de color: el fondo, las celdas de los mosaicos y las cajas de los nodos vivos que tienen caja, con la
# cámara siguiendo al jugador dentro del nivel.
func dibujar():
    jugador = nodo("Jugador")
    cx = 0.0
    si jugador.existe():
        caja_de(entero(jugador))
        cx = minimo(maximo(fis.kx - ANCHO / 2.0, 0.0), escena.ANCHO_NIVEL - ANCHO)
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    glOrtho(cx, cx + ANCHO, decimal(ALTO), 0.0, -1.0, 1.0)
    glClear(GL_COLOR_BUFFER_BIT)
    vivos: lista[entero] = []
    recorrer(mundo.raiz, vivos)
    para h en vivos:
        si mundo.solido[h] == 3:
            caja_de(h)
            t = mundo.cw[h]
            para k en rango(largo(mundo.celdas_c[h])):
                x = fis.me + decimal(mundo.celdas_c[h][k]) * t
                y_ = fis.mf + decimal(mundo.celdas_f[h][k]) * t
                color(mundo.color[h])
                glRectd(x, y_, x + t, y_ + t)
                color(escena.BORDE_MOSAICO)
                glRectd(x, y_, x + t, y_ + 4.0)
    para h en vivos:
        si mundo.color[h] >= 0 y mundo.solido[h] != 3 y mundo.ctipo[h] != 0 y mundo.nombre[h] != "Jugador":
            caja(h, mundo.color[h])
    si jugador.existe():
        caja(entero(jugador), mundo.color[entero(jugador)])  # el jugador, delante de todo

func caja(h: entero, c: entero):
    caja_de(h)
    color(c)
    glRectd(fis.kx - fis.kw / 2.0, fis.ky - fis.kh / 2.0, fis.kx + fis.kw / 2.0, fis.ky + fis.kh / 2.0)

# El fotograma (BGRA, de abajo arriba) a un BMP de 32 bits.
func guardar_bmp(ruta: texto):
    n = ANCHO * ALTO * 4
    b = bufer(54 + n + 1024)
    poner_u8(b, 0, 66)
    poner_u8(b, 1, 77)
    poner_i32(b, 2, 54 + n)
    poner_i32(b, 10, 54)
    poner_i32(b, 14, 40)
    poner_i32(b, 18, ANCHO)
    poner_i32(b, 22, ALTO)
    poner_u16(b, 26, 1)
    poner_u16(b, 28, 32)
    poner_i32(b, 34, n)
    glReadPixels(0, 0, ANCHO, ALTO, GL_BGRA, GL_UNSIGNED_BYTE, direccion(b, 54))
    poner_texto_ancho(b, 54 + n, ruta)
    h = CreateFileW(direccion(b, 54 + n), 1073741824, 0, 0, 2, 128, 0)  # GENERIC_WRITE, CREATE_ALWAYS
    WriteFile(h, direccion(b, 0), 54 + n, direccion(b, 54 + n + 1016), 0)
    CloseHandle(h)
    soltar_bufer(b)

# ---------- Programa ----------

# El estado tras un paso (el formato que lee `leerEstadoNativo` de herramientas/escena-nativa-2d.mjs): los personajes y
# los pares que se tocan, por su posición entre los nodos vivos, y los puntos, el estado de la partida y cuántos nodos
# quedan.
func escribir_estado(t: Bufer, i: entero):
    imprimir("paso {i}")
    vivos: lista[entero] = []
    recorrer(mundo.raiz, vivos)
    para h en vivos:
        si mundo.tipo[h] == "Personaje2D":
            imprimir("personaje {posicion_en(vivos, h)} {cifras(t, mundo.px[h])} {cifras(t, mundo.py[h])} {cifras(t, mundo.vy[h])} {cifras(t, mundo.emp_x[h])} {cifras(t, mundo.emp_y[h])} {mundo.en_suelo[h]} {posicion_en(vivos, mundo.nodo_suelo[h])}")
    para k en rango(largo(mundo.pares_a)):
        imprimir("par {posicion_en(vivos, mundo.pares_a[k])} {posicion_en(vivos, mundo.pares_b[k])}")
    imprimir("juego {mundo.puntos} {mundo.estado} {largo(vivos)}")

func posicion_en(l: lista[entero], h: entero) -> entero:
    para k en rango(largo(l)):
        si l[k] == h:
            devolver k
    devolver -1

b = bufer(4096)  # las estructuras de la ventana
t = bufer(1024)  # lo de las funciones de arriba (entorno, tiempo, cifras)
cargar_escena()
QueryPerformanceFrequency(direccion(t, 0))
frecuencia = leer_i64(t, 0)
pasos = variable(t, "FALCON_PASOS")
captura = variable(t, "FALCON_CAPTURA")
guion = variable(t, "FALCON_GUION")
pasos_captura = PASOS_CAPTURA
si variable(t, "FALCON_CAPTURA_PASOS") != "":
    pasos_captura = entero(variable(t, "FALCON_CAPTURA_PASOS"))

si pasos != "":
    # Sin ventana: el guion, y el estado en texto (con FALCON_TRAZA, tras cada paso; si no, solo al final).
    n = entero(pasos)
    traza = variable(t, "FALCON_TRAZA") != ""
    t0 = segundos(t, frecuencia)
    para i en rango(n):
        entrada(guion_en(guion, i))
        paso()
        si traza o i == n - 1:
            escribir_estado(t, i)
    ms = (segundos(t, frecuencia) - t0) * 1000.0 / decimal(maximo(n, 1))
    imprimir("ms_por_paso {ms}")
sino:
    poner_texto_ancho(b, 96, "FalconNativo2D")
    poner_texto_ancho(b, 160, "Falcon Engine nativo: plataformas (Ara + OpenGL)")
    instancia = GetModuleHandleW(0)
    poner_i32(b, 0, 80)  # WNDCLASSEXW
    poner_i32(b, 4, CS_VREDRAW_HREDRAW_OWNDC)
    poner_i64(b, 8, retrollamada(ventana_proc))
    poner_i64(b, 24, instancia)
    poner_i64(b, 40, LoadCursorW(0, IDC_ARROW))
    poner_i64(b, 64, direccion(b, 96))
    RegisterClassExW(direccion(b, 0))
    # El área de dibujo, de ANCHO × ALTO: la ventana es algo mayor (RECT en 512).
    poner_i32(b, 520, ANCHO)
    poner_i32(b, 524, ALTO)
    AdjustWindowRect(direccion(b, 512), WS_OVERLAPPEDWINDOW, falso)
    ventana = CreateWindowExW(0, direccion(b, 96), direccion(b, 160), WS_OVERLAPPEDWINDOW + WS_VISIBLE, 60, 60, leer_i32(b, 520) - leer_i32(b, 512), leer_i32(b, 524) - leer_i32(b, 516), 0, 0, instancia, 0)
    dc = GetDC(ventana)
    poner_u16(b, 384, 40)  # PIXELFORMATDESCRIPTOR: RGBA de 32 bits, doble búfer, para OpenGL
    poner_u16(b, 386, 1)
    poner_i32(b, 388, 37)
    poner_u8(b, 393, 32)
    SetPixelFormat(dc, ChoosePixelFormat(dc, direccion(b, 384)), direccion(b, 384))
    contexto = wglCreateContext(dc)
    wglMakeCurrent(dc, contexto)
    poner_texto(b, 3072, "wglSwapIntervalEXT")
    intervalo = wglGetProcAddress(direccion(b, 3072))
    con_sincronia = intervalo != 0 y gl_intervalo(intervalo, 1)
    glViewport(0, 0, ANCHO, ALTO)
    fondo = escena.FONDO
    glClearColor(decimal(fondo // 65536) / 255.0, decimal(fondo // 256 % 256) / 255.0, decimal(fondo % 256) / 255.0, 1)

    # Bucle: mensajes, física a paso fijo con el tiempo real (hasta 5 pasos por fotograma) y un fotograma.
    antes = segundos(t, frecuencia)
    inicio = antes
    acumulado = 0.0
    hechos = 0
    fotogramas = 0
    mientras no cerrada:
        mientras PeekMessageW(direccion(b, 1024), 0, 0, 0, PM_REMOVE):
            TranslateMessage(direccion(b, 1024))
            DispatchMessageW(direccion(b, 1024))
        si cerrada:
            romper
        ahora_s = segundos(t, frecuencia)
        acumulado = minimo(acumulado + ahora_s - antes, 5.0 * escena.DT)
        antes = ahora_s
        mientras acumulado >= escena.DT:
            acumulado -= escena.DT
            si captura != "":
                entrada(guion_en(guion, hechos))
            sino:
                teclas = 0
                si pulsada(VK_RIGHT) o pulsada(TECLA_D):
                    teclas += 1
                si pulsada(VK_LEFT) o pulsada(TECLA_A):
                    teclas += 2
                si pulsada(VK_SPACE) o pulsada(VK_UP) o pulsada(TECLA_W):
                    teclas += 4
                entrada(teclas)
            paso()
            hechos += 1
        dibujar()
        si captura != "" y hechos >= pasos_captura:
            guardar_bmp(captura)
            PostMessageW(ventana, WM_CLOSE, 0, 0)
        SwapBuffers(dc)
        fotogramas += 1
        si no con_sincronia:
            Sleep(1)
    duracion = segundos(t, frecuencia) - inicio
    wglMakeCurrent(0, 0)
    wglDeleteContext(contexto)
    imprimir("fotogramas {fotogramas}, pasos {hechos}, {decimal(fotogramas) / maximo(duracion, 0.001)} fps, puntos {mundo.puntos}, estado {mundo.estado}")
soltar_bufer(b)
soltar_bufer(t)
