externa "kernel32.dll" func CreateFileW(ruta: entero, acceso: u32, compartir: u32, seguridad: entero, crear: u32, banderas: u32, plantilla: entero) -> entero
externa "kernel32.dll" func WriteFile(archivo: entero, datos: entero, n: u32, escritos: entero, solapado: entero) -> booleano
externa "kernel32.dll" func CloseHandle(h: entero) -> booleano
externa "kernel32.dll" func Sleep(milisegundos: u32)
