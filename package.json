{
  "name": "falcon-engine",
  "productName": "Falcon Engine",
  "version": "1.2.0",
  "description": "Motor de videojuegos 2D y 3D con el lenguaje Águila",
  "main": "src/principal/main.js",
  "author": "Falcon Engine",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "prestart": "node herramientas/reconstruir-cqb.cjs",
    "pretest": "node herramientas/reconstruir-cqb.cjs",
    "test": "node pruebas/ejecutar.js",
    "build:win": "node herramientas/construir.js win32 x64",
    "build:linux": "node herramientas/construir.js linux x64",
    "build:linux-arm": "node herramientas/construir.js linux arm64",
    "prebuild:win": "node herramientas/reconstruir-cqb.cjs",
    "prebuild:linux": "node herramientas/reconstruir-cqb.cjs",
    "prebuild:linux-arm": "node herramientas/reconstruir-cqb.cjs",
    "release:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "prerelease:win": "node herramientas/reconstruir-cqb.cjs",
    "prerelease:linux": "node herramientas/reconstruir-cqb.cjs",
    "prerelease:linux-arm": "node herramientas/reconstruir-cqb.cjs",
    "release:linux": "electron-builder --config electron-builder.config.cjs --linux AppImage --x64",
    "release:linux-arm": "electron-builder --config electron-builder.config.cjs --linux AppImage --arm64",
    "test:actualizaciones": "node --test pruebas/actualizaciones.test.cjs"
  },
  "dependencies": {
    "@electron/get": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "three": "^0.186.1",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.7",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "falconUpdates": {
    "repository": "MixdenYT/Falcon-engine"
  }
}
