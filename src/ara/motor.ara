externa propiedad Nodo.rotacion_y: decimal
externa propiedad Nodo.rotacion_z: decimal
externa propiedad Nodo.escala_x: decimal
externa propiedad Nodo.escala_y: decimal
externa propiedad Nodo.escala_z: decimal
externa propiedad Nodo.velocidad: decimal
externa propiedad Nodo.salto: decimal
externa propiedad Nodo.velocidad_x: decimal
externa propiedad Nodo.velocidad_y: decimal
externa propiedad Nodo.velocidad_z: decimal
externa propiedad Nodo.usa_gravedad: booleano
externa propiedad Nodo.gravedad: decimal
externa propiedad Nodo.cuadro: entero
externa propiedad Nodo.voltear_h: booleano
externa propiedad Nodo.color: texto
