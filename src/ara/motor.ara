# ---------- Métodos de los nodos ----------
externa func Nodo.existe(este) -> booleano
externa func Nodo.es(este, que: texto) -> booleano
externa func Nodo.eliminar(este)
# Llama a una función del script del nodo (de Ara, de Águila o de un Blueprint) por su nombre.
externa func Nodo.llamar(este, funcion: texto)
externa func Nodo.llamar(este, funcion: texto, a: decimal)
externa func Nodo.llamar(este, funcion: texto, a: decimal, b: decimal)
externa func Nodo.llamar(este, funcion: texto, a: decimal, b: decimal, c: decimal)
# Lo mismo para una función que devuelve un número.
externa func Nodo.consultar(este, funcion: texto) -> decimal
externa func Nodo.consultar(este, funcion: texto, a: decimal) -> decimal
externa func Nodo.consultar(este, funcion: texto, a: decimal, b: decimal) -> decimal
externa func Nodo.consultar(este, funcion: texto, a: decimal, b: decimal, c: decimal) -> decimal
# Los campos del script de otro nodo (de Ara, de Águila o de un Blueprint) por su nombre, o una propiedad del nodo.
externa func Nodo.leer_numero(este, campo: texto) -> decimal
externa func Nodo.leer_texto(este, campo: texto) -> texto
externa func Nodo.leer_booleano(este, campo: texto) -> booleano
externa func Nodo.leer_nodo(este, campo: texto) -> Nodo
externa func Nodo.cambiar_numero(este, campo: texto, valor: decimal)
externa func Nodo.cambiar_texto(este, campo: texto, valor: texto)
externa func Nodo.cambiar_booleano(este, campo: texto, valor: booleano)
externa func Nodo.cambiar_nodo(este, campo: texto, valor: Nodo)
externa func Nodo.hijo(este, nombre: texto) -> Nodo
externa func Nodo.en_grupo(este, grupo: texto) -> booleano
externa func Nodo.añadir_a_grupo(este, grupo: texto)
externa func Nodo.quitar_de_grupo(este, grupo: texto)
externa func Nodo.mover_a(este, x: decimal, y: decimal)
externa func Nodo.mover_a(este, x: decimal, y: decimal, z: decimal)
externa func Nodo.desplazar(este, dx: decimal, dy: decimal)
externa func Nodo.desplazar(este, dx: decimal, dy: decimal, dz: decimal)
