# API de Falcon Engine para los scripts de Ara (ver docs/JUEGOS.md en el repositorio de Ara).
# Lo implementa src/ara/puente.js con la misma lógica que usa Águila (src/motor/mundo.js).
#
# Todos los nodos son `Nodo` y tienen todos los miembros: si un nodo no admite uno (por ejemplo, `saltar` en una
# Etiqueta), falla al ejecutarse con un error que lo explica, igual que en Águila. Los tipos concretos sirven para
# `clase X extiende Personaje2D:`. Un `Nodo` que no existe (lo que devuelve `nodo("nadie")`) no es nada: compruébalo
# con `.existe()`.

# ---------- Tipos de nodo ----------
externa tipo Nodo
externa tipo Nodo2D extiende Nodo
externa tipo Personaje2D extiende Nodo2D
externa tipo Sprite extiende Nodo2D
externa tipo Colision extiende Nodo2D
externa tipo Camara2D extiende Nodo2D
externa tipo Mosaicos extiende Nodo2D
externa tipo Plataforma extiende Nodo2D
externa tipo Area2D extiende Nodo2D
externa tipo Fondo extiende Nodo2D
externa tipo Particulas2D extiende Nodo2D
externa tipo Interfaz extiende Nodo
externa tipo Etiqueta extiende Interfaz
externa tipo Boton extiende Interfaz
externa tipo PanelUI extiende Interfaz
externa tipo Nodo3D extiende Nodo
externa tipo Malla3D extiende Nodo3D
externa tipo Luz3D extiende Nodo3D
externa tipo Entorno extiende Nodo3D
externa tipo VolumenLumbre extiende Nodo3D
externa tipo Camara3D extiende Nodo3D
externa tipo Personaje3D extiende Nodo3D
externa tipo Sonido extiende Nodo
externa tipo Temporizador extiende Nodo

# ---------- Eventos ----------
externa evento empieza()
externa evento se_actualiza(delta: decimal)
externa evento toca(otro: Nodo)
externa evento deja_de_tocar(otro: Nodo)
externa evento se_pulsa(accion: texto)
externa evento se_suelta(accion: texto)
externa evento recibe(senal: texto, datos: texto)
externa evento hace_clic()
externa evento termina()
externa evento se_elimina()

