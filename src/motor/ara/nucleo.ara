# Lo que el núcleo wasm del motor exporta a JS (src/motor/nucleo-ara.js). Las clases de script son la única forma de
# exportar funciones a JS, así que aquí solo hay envolturas finas: la lógica está en módulos que también compilan a
# nativo (fisica2d.ara).

externa tipo Nucleo

# La física 2D (`Fisica` de fisica2d.ara), con resultados que cruzan como números.
clase Fisica2D extiende Nucleo:
    f = Fisica()

    func empezar(n: entero):
        f.empezar(n)

    func nodo(i: entero, p: entero, sin_matriz: booleano, x: decimal, y_: decimal, grados: decimal, esc: booleano, sx: decimal, sy: decimal, caja_tipo: entero, ox: decimal, oy: decimal, w: decimal, h: decimal, solido: entero, cl: entero):
        f.nodo(i, p, sin_matriz, x, y_, grados, esc, sx, sy, caja_tipo, ox, oy, w, h, solido, cl)

    func preparar() -> entero:
        devolver f.preparar()

    func solido_cx(k: entero) -> decimal:
        devolver f.scx[k]

    func solido_cy(k: entero) -> decimal:
        devolver f.scy[k]

    func vaciar_celdas():
        f.vaciar_celdas()

    func celda(m: entero, c: entero, fila: entero):
        f.celda(m, c, fila)

    func mover(i: entero, mueve_x: decimal, mueve_y: decimal, e_x: decimal, e_y: decimal, v_y: decimal, usa_gravedad: booleano, gravedad: decimal, dt: decimal, amort: decimal, arrastre_x: decimal, arrastre_y: decimal):
        f.mover(i, mueve_x, mueve_y, e_x, e_y, v_y, usa_gravedad, gravedad, dt, amort, arrastre_x, arrastre_y)

    func r_ddx() -> decimal:
        devolver f.ddx

    func r_ddy() -> decimal:
        devolver f.ddy

    func r_emp_x() -> decimal:
        devolver f.emp_x

    func r_emp_y() -> decimal:
        devolver f.emp_y

    func r_vy() -> decimal:
        devolver f.vy

    # suelo + 2·pared + 4·techo (una llamada en vez de tres).
    func r_banderas() -> entero:
        devolver f.banderas()

    func r_nodo_suelo() -> entero:
        devolver f.nodo_suelo

    func r_contactos() -> entero:
        devolver f.nc

    func contacto(k: entero) -> entero:
        devolver f.contactos[k]

    func pares() -> entero:
        devolver f.pares()

    func par_a(k: entero) -> entero:
        devolver f.pa[k]

    func par_b(k: entero) -> entero:
        devolver f.pb[k]


# Solucionador de movimiento y colisiones 3D. La escena entrega AABB y recibe resultados.
clase Fisica3D extiende Nucleo:
    f = Solucionador3D()

    func empezar():
        f.empezar()

    func preparar():
        f.preparar()

    func empezar_personaje():
        f.empezar_personaje()

    func caja(x0: decimal, y0: decimal, z0: decimal, x1: decimal, y1: decimal, z1: decimal, dueno: entero, cuerpo: booleano, movil: booleano):
        f.caja(x0, y0, z0, x1, y1, z1, dueno, cuerpo, movil)

    func mover(x: decimal, y_: decimal, z: decimal, radio: decimal, altura: decimal, altura_techo: decimal, vx: decimal, vz: decimal, emp_x: decimal, emp_z: decimal, amort: decimal, vy: decimal, usa_gravedad: booleano, gravedad: decimal, escala_gravedad: decimal, dt: decimal):
        f.mover(x, y_, z, radio, altura, altura_techo, vx, vz, emp_x, emp_z, amort, vy, usa_gravedad, gravedad, escala_gravedad, dt)

    func r_x() -> decimal:
        devolver f.resultado_x()

    func r_y() -> decimal:
        devolver f.resultado_y()

    func r_z() -> decimal:
        devolver f.resultado_z()

    func r_vy() -> decimal:
        devolver f.resultado_vy()

    func r_vx() -> decimal:
        devolver f.resultado_vx()

    func r_vz() -> decimal:
        devolver f.resultado_vz()

    func r_emp_x() -> decimal:
        devolver f.resultado_emp_x()

    func r_emp_z() -> decimal:
        devolver f.resultado_emp_z()

    func r_banderas() -> entero:
        devolver f.banderas()

    func r_contactos() -> entero:
        devolver f.cantidad_de_contactos()

    func contacto(i: entero) -> entero:
        devolver f.contacto(i)


# Movimiento de personajes 3D: el anfitrión solo entrega entrada, estado y ejes de cámara.
clase Movimiento3D extiende Nucleo:
    f = ControladorMovimiento3D()

    func actualizar(eje_x: decimal, eje_z: decimal, velocidad_base: decimal, dt: decimal, tactico: booleano, agachado: booleano, lento: booleano, apuntando: booleano, tecla_correr: booleano, muerto: booleano, suelo_actual: booleano, yaw_activo: booleano, yaw: decimal, adelante_x: decimal, adelante_z: decimal, derecha_x: decimal, derecha_z: decimal, velocidad_x: decimal, velocidad_z: decimal, velocidad_y: decimal, coyote_actual: decimal, recordado_actual: decimal, saltando_actual: booleano, pulsa_saltar: booleano, mantiene_saltar: booleano, velocidad_salto: decimal, altura_actual: decimal, altura_objetivo: decimal):
        f.actualizar(eje_x, eje_z, velocidad_base, dt, tactico, agachado, lento, apuntando, tecla_correr, muerto, suelo_actual, yaw_activo, yaw, adelante_x, adelante_z, derecha_x, derecha_z, velocidad_x, velocidad_z, velocidad_y, coyote_actual, recordado_actual, saltando_actual, pulsa_saltar, mantiene_saltar, velocidad_salto, altura_actual, altura_objetivo)

    func r_vx() -> decimal:
        devolver f.resultado_vx()

    func r_vz() -> decimal:
        devolver f.resultado_vz()

    func r_vy() -> decimal:
        devolver f.resultado_vy()

    func r_mueve_x() -> decimal:
        devolver f.resultado_mueve_x()

    func r_mueve_z() -> decimal:
        devolver f.resultado_mueve_z()

    func r_coyote() -> decimal:
        devolver f.resultado_coyote()

    func r_recordado() -> decimal:
        devolver f.resultado_recordado()

    func r_altura() -> decimal:
        devolver f.resultado_altura()

    func r_banderas() -> entero:
        devolver f.banderas()


# Cámara 3D: Ara calcula el estado, la órbita, el seguimiento y el movimiento de cámara.
clase Camara3D extiende Nucleo:
    f = ControladorCamara3D()

    func iniciar(offset_x: decimal, offset_y: decimal, offset_z: decimal, rotacion_y: decimal, yaw_visual: decimal, visual_presente: booleano, posicion_x: decimal, posicion_y: decimal, posicion_z: decimal, altura: decimal, primera_persona: booleano, fov_inicial: decimal):
        f.iniciar(offset_x, offset_y, offset_z, rotacion_y, yaw_visual, visual_presente, posicion_x, posicion_y, posicion_z, altura, primera_persona, fov_inicial)

    func cambiar_modo(posicion_x: decimal, posicion_y: decimal, posicion_z: decimal, altura: decimal, primera_persona: booleano):
        f.cambiar_modo(posicion_x, posicion_y, posicion_z, altura, primera_persona)

    func preparar(posicion_x: decimal, posicion_y: decimal, posicion_z: decimal, altura: decimal, primera_persona: booleano, sensibilidad: decimal, invertir_y: booleano, tactico: booleano, apuntando: booleano, stick_x: decimal, stick_y: decimal, raton_x: decimal, raton_y: decimal, rueda: decimal, capturado: booleano, velocidad_x: decimal, velocidad_z: decimal, velocidad_base: decimal, correr: booleano, en_suelo: booleano, velocidad_y: decimal, dt: decimal, inclinar_derecha: booleano, inclinar_izquierda: booleano):
        f.preparar(posicion_x, posicion_y, posicion_z, altura, primera_persona, sensibilidad, invertir_y, tactico, apuntando, stick_x, stick_y, raton_x, raton_y, rueda, capturado, velocidad_x, velocidad_z, velocidad_base, correr, en_suelo, velocidad_y, dt, inclinar_derecha, inclinar_izquierda)

    func finalizar(distancia_libre: decimal, distancia_inclinacion_libre: decimal, dt: decimal, primera_persona: booleano, tactico: booleano, apuntando: booleano, correr: booleano):
        f.finalizar(distancia_libre, distancia_inclinacion_libre, dt, primera_persona, tactico, apuntando, correr)

    func r_yaw() -> decimal:
        devolver f.resultado_yaw()

    func r_pitch() -> decimal:
        devolver f.resultado_pitch()

    func r_distancia() -> decimal:
        devolver f.resultado_distancia()

    func r_distancia_actual() -> decimal:
        devolver f.resultado_distancia_actual()

    func r_deseada() -> decimal:
        devolver f.resultado_deseada()

    func r_zoom() -> decimal:
        devolver f.resultado_zoom()

    func r_pivote_x() -> decimal:
        devolver f.resultado_pivote_x()

    func r_pivote_y() -> decimal:
        devolver f.resultado_pivote_y()

    func r_pivote_z() -> decimal:
        devolver f.resultado_pivote_z()

    func r_dir_x() -> decimal:
        devolver f.resultado_dir_x()

    func r_dir_y() -> decimal:
        devolver f.resultado_dir_y()

    func r_dir_z() -> decimal:
        devolver f.resultado_dir_z()

    func r_cam_x() -> decimal:
        devolver f.resultado_cam_x()

    func r_cam_y() -> decimal:
        devolver f.resultado_cam_y()

    func r_cam_z() -> decimal:
        devolver f.resultado_cam_z()

    func r_roll() -> decimal:
        devolver f.resultado_roll()

    func r_fov() -> decimal:
        devolver f.resultado_fov()

    func r_fov_base() -> decimal:
        devolver f.resultado_fov_base()

    func r_sin_raton() -> decimal:
        devolver f.resultado_sin_raton()

    func r_fase() -> decimal:
        devolver f.resultado_fase()

    func r_bob() -> decimal:
        devolver f.resultado_bob()

    func r_golpe() -> decimal:
        devolver f.resultado_golpe()

    func r_caida_max() -> decimal:
        devolver f.resultado_caida_max()

    func r_en_suelo_antes() -> booleano:
        devolver f.resultado_en_suelo_antes()

    func r_inclinacion() -> decimal:
        devolver f.resultado_inclinacion()

    func r_ads() -> decimal:
        devolver f.resultado_ads()

    func r_retroceso() -> decimal:
        devolver f.resultado_retroceso()

    func r_ocultar() -> booleano:
        devolver f.resultado_ocultar()
